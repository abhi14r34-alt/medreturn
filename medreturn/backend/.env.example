# ---------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env to git.
# ---------------------------------------------------------------

# --- Application ---
APP_NAME=MedReturn
ENVIRONMENT=development
API_PREFIX=/api

# --- Database (MySQL 8+) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=medreturn
MYSQL_PASSWORD=change_me
MYSQL_DB=medreturn

# --- Security ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_this_with_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI / decision engine ---
DEMO_MODE=true
CONFIDENCE_THRESHOLD=0.80
MODEL_PATH=../ml/models/model.pth
MODEL_VERSION=v1.2
# JSON array. Items with these model labels are always reviewed by a person.
HUMAN_VERIFICATION_LABELS=["General"]

# --- Rewards ---
CREDITS_PER_VERIFIED_RETURN=50

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Email ---
# Leave SMTP_HOST blank (or set EMAIL_ENABLED=false) for the safe console
# transport. Configure one real provider in your local .env to send mail.
# Port 587 normally uses STARTTLS; port 465 normally uses implicit SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@medreturn.in
SMTP_TLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15
SMTP_REPLY_TO=
EMAIL_ENABLED=true
# Set true to email each household analysis result. Pickup/credit updates are
# sent whenever SMTP delivery is enabled.
EMAIL_SEND_ANALYSIS_RESULTS=false

# --- Maps provider (abstraction; blank = demo tracking) ---
MAPS_PROVIDER=demo
MAPS_API_KEY=

# --- Hardware controller (abstraction; blank = simulated) ---
HARDWARE_ENDPOINT=
